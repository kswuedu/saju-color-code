function getExportFileName(mode, ext) {
  if (mode === "single") {
    const rawName = (document.getElementById("userName").value.trim() || "사용자").replace(/[\\/:*?"<>|]/g, "");
    return `사주컬러코드_분석리포트_${rawName}.${ext}`;
  } else {
    const n1 = (document.getElementById("p1Name").value.trim() || "나").replace(/[\\/:*?"<>|]/g, "");
