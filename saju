      flex: 1;
      min-width: 140px;
      padding: 12px 10px;
      border: none;
      border-radius: 10px;
      font-size: 0.92rem;
      font-weight: 700;
      color: #475569;
      background: transparent;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .tab-btn.active {
      background: #ffffff;
      color: #0f172a;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    }

    /* 카드 공통 */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 18px;
      box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
    }
    .section-title {
      font-size: 1.08rem;
      font-weight: 700;
      margin-bottom: 16px;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    /* 입력 폼 */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(205px, 1fr));
      gap: 16px;
    }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: 0.84rem; font-weight: 600; color: #475569; }
    input[type="text"], input[type="date"], input[type="time"], select, textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      font-size: 0.94rem;
      font-family: inherit;
      background: #ffffff;
      color: var(--text-main);
      transition: border-color 0.15s;
    }
    textarea { min-height: 78px; resize: vertical; line-height: 1.55; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: #2563eb; }
    input:disabled { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
    input[type="color"] {
      width: 54px;
      height: 42px;
      padding: 2px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      background: #ffffff;
      cursor: pointer;
    }
    .inline-options {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 3px;
      font-size: 0.86rem;
    }
    .inline-options label {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 500;
      cursor: pointer;
      padding: 2px 0;
    }
    .solar-time-bar {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px dashed var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.85rem;
      color: #475569;
    }
    .btn-submit {
      width: 100%;
      margin-top: 18px;
      padding: 15px;
      background: #0f172a;
      color: #ffffff;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    .btn-submit:hover { background: #1e293b; }
    .btn-submit:active { transform: scale(0.995); }

    /* 궁합 2인 입력 분리 박스 */
    .couple-input-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 16px;
    }
    .person-box {
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      background: #f8fafc;
    }
    .person-box h3 {
      font-size: 0.98rem;
      font-weight: 800;
      margin-bottom: 12px;
      color: #0f172a;
    }

    /* 알림 메시지 박스 */
    .toast-msg {
      display: none;
      padding: 12px 16px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-top: 12px;
    }
    .toast-info {
      display: none;
      padding: 11px 15px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e40af;
      border-radius: 10px;
      font-size: 0.86rem;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .toast-success {
      display: none;
      padding: 11px 15px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      color: #065f46;
      border-radius: 10px;
      font-size: 0.86rem;
      font-weight: 600;
      margin-bottom: 12px;
    }

    /* 액션 툴바 */
    .action-bar {
      display: flex;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }
    .btn-action {
      background: #ffffff;
      color: #0f172a;
      border: 1px solid #cbd5e1;
      padding: 10px 15px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-action:hover { background: #f1f5f9; }
    .btn-action:disabled { opacity: 0.6; cursor: wait; }
    .btn-primary-pdf {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
    }
    .btn-primary-pdf:hover { background: #1e293b; }
    .btn-png {
      background: #2563eb;
      color: #ffffff;
      border-color: #2563eb;
    }
    .btn-png:hover { background: #1d4ed8; }
    .btn-danger {
      background: #ffffff;
      color: #dc2626;
      border-color: #fecaca;
    }
    .btn-danger:hover { background: #fef2f2; }

    /* 리포트 공통 */
    .capture-zone { background: var(--bg); padding: 4px; border-radius: 16px; }
    .badge-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
    .badge {
      display: inline-block;
      padding: 4px 11px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      background: #f1f5f9;
      color: #334155;
    }
    .badge-animal { background: #eff6ff; color: #1d4ed8; }
    .persona-title {
      font-size: clamp(1.2rem, 3vw, 1.42rem);
      font-weight: 800;
      margin-bottom: 6px;
      color: #0f172a;
      letter-spacing: -0.02em;
    }
    .meta-info { font-size: 0.85rem; color: var(--text-sub); margin-bottom: 16px; }

    /* 컬러 카드 & 라이프스타일 오감 테라피 가이드 */
    .color-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
      margin-top: 12px;
    }
    .color-box {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #f8fafc;
    }
    .swatch {
      width: 58px;
      height: 58px;
      border-radius: 12px;
      flex-shrink: 0;
      border: 1px solid rgba(15, 23, 42, 0.12);
      box-shadow: inset 0 2px 4px rgba(255,255,255,0.25);
    }
    .color-info h4 { font-size: 0.79rem; color: var(--text-sub); font-weight: 600; }
    .color-info p { font-size: 1rem; font-weight: 800; color: #0f172a; margin-top: 1px; }
    .color-info span { font-size: 0.8rem; color: #475569; display: block; margin-top: 2px; line-height: 1.4; }

    .therapy-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 14px;
      margin-top: 14px;
    }
    .therapy-card {
      padding: 16px 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #ffffff;
    }
    .therapy-card-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid #f1f5f9;
    }
    .mini-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1px solid rgba(0,0,0,0.12);
      flex-shrink: 0;
    }
    .therapy-card-header h5 {
      font-size: 0.92rem;
      font-weight: 800;
      color: #0f172a;
    }
    .therapy-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 0.86rem;
      color: var(--text-body);
    }
    .therapy-list li strong {
      color: #0f172a;
      font-weight: 700;
    }

    /* 사주명식 테이블 */
    .table-wrap { width: 100%; overflow-x: auto; }
    .pillars-table { width: 100%; border-collapse: collapse; text-align: center; table-layout: fixed; min-width: 340px; }
    .pillars-table th {
      background: #f1f5f9;
      padding: 10px 6px;
      font-size: 0.82rem;
      color: #475569;
      border: 1px solid var(--border);
    }
    .pillars-table td {
      padding: 11px 6px;
      border: 1px solid var(--border);
      vertical-align: middle;
    }
    .hanja-char { font-size: 1.85rem; font-weight: 800; display: block; line-height: 1.15; }
    .kor-char { font-size: 0.8rem; font-weight: 600; color: var(--text-sub); }
    .sipseong-tag {
      font-size: 0.78rem;
      font-weight: 700;
      color: #334155;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 3px 8px;
      border-radius: 6px;
      display: inline-block;
    }

    .c-목 { color: var(--wood); }
    .c-화 { color: var(--fire); }
    .c-토 { color: var(--earth); }
    .c-금 { color: var(--metal); }
    .c-수 { color: var(--water); }

    /* 대운 & 세운 */
    .daeun-scroll {
      display: grid;
      grid-template-columns: repeat(8, minmax(74px, 1fr));
      gap: 6px;
      text-align: center;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .daeun-cell {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 4px;
      background: #f8fafc;
    }
    .daeun-cell.active-daeun {
      border: 2px solid #2563eb;
      background: #eff6ff;
    }
    .daeun-age { font-size: 0.76rem; font-weight: 700; color: #475569; margin-bottom: 4px; }
    .daeun-ganji { font-size: 1.15rem; font-weight: 800; line-height: 1.25; }
    .daeun-sip { font-size: 0.72rem; color: #64748b; margin-top: 4px; }
    .seun-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 14px;
      margin-top: 16px;
    }
    .seun-box {
      padding: 18px;
      border-radius: 14px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      font-size: 0.9rem;
      color: #451a03;
      line-height: 1.65;
    }
    .seun-box.seun-2027 {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #450a0a;
    }
    .seun-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    .seun-header h4 { font-size: 1rem; font-weight: 800; }
    .seun-badge {
      font-size: 0.76rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.85);
    }
    .seun-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .seun-list li strong { font-weight: 700; }

    /* 최종 종합 요약 카드 */
    .final-summary-card {
      border: 2px solid #0f172a;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }
    .summary-kv-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
      font-size: 0.89rem;
    }
    .summary-kv-table th, .summary-kv-table td {
      border: 1px solid var(--border);
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
    }
    .summary-kv-table th {
      width: 26%;
      background: #f1f5f9;
      font-weight: 700;
      color: #0f172a;
    }
    .summary-kv-table td { color: var(--text-body); background: #ffffff; }
    .pdf-cta-bar {
      margin-top: 20px;
      padding: 18px;
      border-radius: 14px;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .pdf-cta-bar p { font-size: 0.9rem; font-weight: 600; color: #0f172a; }

    /* 오행 막대 그래프 */
    .ohaeng-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .ohaeng-label { width: 68px; font-size: 0.88rem; font-weight: 700; }
    .bar-bg { flex: 1; height: 14px; background: #f1f5f9; border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; transition: width 0.5s ease; }
    .ohaeng-pct { width: 52px; text-align: right; font-size: 0.85rem; font-weight: 700; }
    .ohaeng-summary-box {
      margin-top: 14px;
      padding: 13px 16px;
      background: #f8fafc;
      border-radius: 10px;
      font-size: 0.9rem;
      border-left: 4px solid #0f172a;
      color: var(--text-body);
    }

    /* 10대 상세 분석 */
    .analysis-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .analysis-item {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #ffffff;
    }
    .analysis-item h3 { font-size: 0.98rem; font-weight: 700; color: #0f172a; margin-bottom: 7px; }
    .analysis-item p { font-size: 0.92rem; color: var(--text-body); white-space: pre-line; }

    /* 궁합 결과 전용 스타일 */
    .score-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding: 20px;
      background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
      border-radius: 14px;
      border: 1px solid #dbeafe;
      margin-bottom: 16px;
    }
    .score-circle {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: #0f172a;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.16);
    }
    .score-num { font-size: 1.75rem; font-weight: 800; line-height: 1; }
    .score-unit { font-size: 0.74rem; opacity: 0.85; margin-top: 3px; }
    .sub-scores {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .sub-score-card {
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #ffffff;
      text-align: center;
    }
    .sub-score-card h4 { font-size: 0.81rem; color: var(--text-sub); }
    .sub-score-card .val { font-size: 1.28rem; font-weight: 800; color: #0f172a; margin: 4px 0; }
    .sub-score-card span { font-size: 0.78rem; color: #2563eb; font-weight: 600; }

    /* 데이터 커스텀 편집 탭 */
    .edit-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      padding: 14px 16px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 16px;
    }
    .edit-section-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .color-picker-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* 브라우저 인쇄 시 페이지 경계 잘림 원천 방지 */
    @media print {
      .mode-tabs, #single-input-card, #compat-input-card, #view-editor, .action-bar, .pdf-cta-bar, .toast-info {
        display: none !important;
      }
      body {
        background: #ffffff !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .container { max-width: 100% !important; margin: 0 !important; }
      .capture-zone { background: #ffffff !important; padding: 0 !important; }
      .card, .analysis-item, .seun-box, .color-box, .therapy-card, .score-hero, .summary-kv-table tr {
        box-shadow: none !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .daeun-scroll, .table-wrap { overflow: visible !important; }
      .pdf-page-break {
        break-before: page !important;
        page-break-before: always !important;
      }
    }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>사주&amp;컬러코드</h1>
  </header>

  <!-- 상단 모드 전환 탭 -->
  <div class="mode-tabs">
    <button class="tab-btn active" id="tab-single" onclick="switchTab('single')">개인 사주 &amp; 기질 컬러 분석</button>
    <button class="tab-btn" id="tab-compat" onclick="switchTab('compat')">두 사람 궁합 &amp; 컬러 시너지</button>
    <button class="tab-btn" id="tab-editor" onclick="switchTab('editor')">데이터 관리 &amp; 커스텀 편집</button>
  </div>

  <!-- =====================================================================
       [탭 1] 개인 사주 & 기질 컬러 분석
       ===================================================================== -->
  <div id="view-single">
    <div class="card" id="single-input-card">
      <div class="section-title">출생 정보 입력</div>
      <div class="form-grid">
        <div class="form-group">
          <label for="userName">이름</label>
          <input type="text" id="userName" placeholder="예: 김지민" value="김지민" />
        </div>
        <div class="form-group">
          <label>성별 (대운 순·역행 기준)</label>
          <div class="inline-options" style="padding-top: 6px;">
            <label><input type="radio" name="gender" value="여" checked /> 여성</label>
            <label><input type="radio" name="gender" value="남" /> 남성</label>
          </div>
        </div>
        <div class="form-group">
          <label for="birthDate">생년월일</label>
          <input type="date" id="birthDate" value="1992-08-14" />
          <div class="inline-options">
            <label><input type="radio" name="calType" value="solar" checked onchange="toggleLeap('calType', 'leapLabel', 'isLeap')" /> 양력</label>
            <label><input type="radio" name="calType" value="lunar" onchange="toggleLeap('calType', 'leapLabel', 'isLeap')" /> 음력</label>
            <label id="leapLabel" style="display:none; color:#2563eb;"><input type="checkbox" id="isLeap" /> 윤달</label>
          </div>
        </div>
        <div class="form-group">
          <label for="birthTime">태어난 시간</label>
          <input type="time" id="birthTime" value="10:30" />
          <div class="inline-options">
            <label><input type="checkbox" id="unknownTime" onchange="toggleTime('unknownTime', 'birthTime')" /> 시간 모름 (삼주 분석)</label>
          </div>
        </div>
      </div>

      <div class="solar-time-bar">
        <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
          <input type="checkbox" id="useTrueSolarSingle" checked /> 진태양시 보정 (-30분 적용 · 한국 표준시 경도 보정)
        </label>
        <span>1900~2100년 내장 천문 절입일 정밀 계산</span>
      </div>

      <div id="singleErrorMsg" class="toast-msg"></div>
      <button class="btn-submit" onclick="runSingleAnalysis(true)">내 사주명식 &amp; 기질 컬러 분석하기</button>
    </div>

    <div id="single-report-area" style="display:none;">
      <div class="action-bar">
        <button class="btn-action" id="printBtnSingle" onclick="safePrintReport('single', 'singleInfoMsg')">리포트 인쇄</button>
        <button class="btn-action btn-png" id="pngBtnSingle" onclick="exportReportAsPNG('single', 'pngBtnSingle', 'singleInfoMsg')">고화질 PNG 저장</button>
        <button class="btn-action btn-primary-pdf" id="pdfBtnSingle" onclick="exportReportAsPDF('single', 'pdfBtnSingle', 'singleInfoMsg')">PDF 파일 다운로드</button>
      </div>
      <div id="singleInfoMsg" class="toast-info"></div>

      <div id="single-capture" class="capture-zone">
        <!-- 종합 요약 & 기질 컬러 + 오감 테라피 가이드 -->
        <div class="card">
          <div class="badge-row">
            <span class="badge" id="hashBadge">명식 코드</span>
            <span class="badge badge-animal" id="animalBadge">60갑자 물상</span>
          </div>
