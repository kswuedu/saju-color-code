function evaluateCheonganCompat(g1, g2) {
  if (Math.abs(g1 - g2) === 5) {
    return {
      score: 98,
      label: "천간합(생각·가치관 코드 일치)",
      desc: `천간합(생각·가치관 코드가 자석처럼 하나로 통하는 최상의 합) 구조입니다. 두 사람은 서로 다른 성향을 가졌지만 만나면 자연스럽게 끌려 하나의 팀이 됩니다. 설명을 길게 하지 않아도 상대방이 왜 그런 생각을 했는지 본능적으로 이해하며 가치관의 방향이 잘 맞습니다.`
    };
  }
  const oh1 = Math.floor(g1 / 2);
  const oh2 = Math.floor(g2 / 2);
  const diff = (oh2 - oh1 + 5) % 5;

  if (diff === 1 || diff === 4) {
    return {
      score: 88,
      label: "천간상생(서로 밀어주는 아낌없는 응원)",
      desc: `천간상생(한 사람이 아이디어를 내면 다른 한 사람이 자연스럽게 힘을 보태주는 응원 구조) 관계입니다. 대화가 막힘없이 부드럽게 흐르고, 함께 있을수록 서로의 장점과 자신감이 살아나는 건강한 파트너십입니다.`
    };
  }
  if (diff === 0) {
    return {
      score: 82,
      label: "천간비화(친구처럼 편안한 비슷한 결)",
      desc: `천간비화(비슷한 기질과 사고방식을 공유하는 동반자 구조) 관계로 처음 만나도 오랜 친구처럼 편안하고 코드가 잘 통합니다. 다만 두 사람 모두 자기 주관이 뚜렷할 수 있으니 의견이 다를 때는 한 번씩 먼저 양보하는 배려가 관계를 더욱 빛나게 합니다.`
    };
  }
  return {
    score: 72,
    label: "천간상극(서로 다른 매력과 역할 분담 시너지)",
    desc: `천간상극(생각하는 방식과 일 처리 속도가 서로 달라 신선한 자극을 주는 관계) 구조입니다. 처음에는 '나랑 참 다르네!'라는 호기심과 긴장감을 동시에 느낍니다. 내 방식을 상대에게 강요하지 않고 각자 잘하는 역할을 나누어 맡으면 서로의 빈틈을 완벽히 메워주는 단단한 팀이 됩니다.`
  };
}

function evaluateJijiCompat(j1, j2) {
  const yukHapPairs = [[0,1], [2,11], [3,10], [4,9], [5,8], [6,7]];
  const isYukHap = yukHapPairs.some(([a, b]) => (j1 === a && j2 === b) || (j1 === b && j2 === a));
  if (isYukHap) {
    return {
      score: 96,
      label: "지지육합(현실·생활 밀착 찰떡 호흡)",
      desc: `지지육합(일상생활의 리듬과 속마음의 온도가 아주 잘 맞는 밀착 궁합) 구조입니다. 함께 밥을 먹고 시간을 보낼 때 마음이 가장 편안해지며, 연애는 물론 결혼이나 동업처럼 오랜 시간 붙어 지내는 관계에서 진가가 드러납니다.`
    };
  }

  const samHapGroups = [[8,0,4], [11,3,7], [2,6,10], [5,9,1]];
  const isSamHap = j1 !== j2 && samHapGroups.some(grp => grp.includes(j1) && grp.includes(j2));
  if (isSamHap) {
    return {
      score: 92,
      label: "지지삼합(함께 성장하는 목표 시너지)",
      desc: `지지삼합(두 사람이 함께 목표를 세우고 움직일 때 혼자일 때보다 훨씬 큰 추진력이 생기는 미래 설계 호흡) 구조입니다. 여행, 재테크, 공동 프로젝트 등 미래를 함께 계획하고 실행할 때 호흡이 척척 맞습니다.`
    };
  }

  if (Math.abs(j1 - j2) === 6) {
    return {
      score: 68,
      label: "지지충(강렬한 자극·변화 포인트와 생활 조율)",
      desc: `지지충(정반대의 매력을 지녀 첫눈에 강렬하게 끌리지만 생활 습관이나 휴식 방식이 달라 자극이 되는 구조)입니다. 사소한 일로 부딪힐 수 있으나, 서로의 개인 시간과 공간을 존중해 주면 갈등은 줄고 신선한 설렘이 오래 유지됩니다.`
    };
  }

  return {
    score: 80,
    label: "지지평화(무리 없이 편안한 안정적 일상 호흡)",
    desc: `지지평화(일상생활에서 크게 부딪히는 부분 없이 서로의 영역을 자연스럽게 존중해 주는 안정적인 흐름)입니다. 함께 즐길 수 있는 공통 취미나 주말 루틴을 만들어갈수록 정이 깊어집니다.`
  };
}

function evaluateOhaengSynergy(p1, p2) {
  const p2SupplyForP1 = p2.ratios[p1.weakestOhaeng] || 0;
  const p1SupplyForP2 = p1.ratios[p2.weakestOhaeng] || 0;
  const avgSupply = (p2SupplyForP1 + p1SupplyForP2) / 2;
  const rawScore = Math.min(99, Math.max(65, Math.round(65 + avgSupply * 1.1)));

  let label = "오행상보(균형 보완형 파트너)";
  if (rawScore >= 90) label = "오행상생(최상의 에너지 상호 충전)";
  else if (rawScore >= 80) label = "오행조화(우수한 에너지 균형)";

  const desc = `오행 상호보완 분석 결과, ${p1.name}님에게 가장 부족한 '${OHAENG_LACKING_GUIDE[p1.weakestOhaeng].label}' 에너지를 ${p2.name}님이 자연스럽게 품고 있고, 반대로 ${p2.name}님에게 부족한 '${OHAENG_LACKING_GUIDE[p2.weakestOhaeng].label}' 에너지를 ${p1.name}님이 채워주는 구조입니다. 두 사람이 함께하면 각자 혼자 있을 때보다 마음의 안정감과 현실적인 실행력이 한층 높아집니다.`;

  return { score: rawScore, label, desc };
}

