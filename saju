function buildMultiPagePdfBinary(jpegPages) {
  const encoder = new TextEncoder();
  const chunks = [];
  let byteLength = 0;

  function pushStr(str) {
    const bytes = encoder.encode(str);
    chunks.push(bytes);
    byteLength += bytes.length;
  }
  function pushBytes(uint8) {
    chunks.push(uint8);
    byteLength += uint8.length;
  }

  const offsets = [0];
  function startObj(objNum) {
    offsets[objNum] = byteLength;
    pushStr(`${objNum} 0 obj\n`);
  }
  function endObj() {
    pushStr(`endobj\n`);
  }

  pushStr("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n");

  const pageCount = jpegPages.length;
  const pageObjNums = [];
  for (let i = 0; i < pageCount; i++) pageObjNums.push(3 + i * 3);

  startObj(1);
  pushStr(`<< /Type /Catalog /Pages 2 0 R >>\n`);
  endObj();

  startObj(2);
  pushStr(`<< /Type /Pages /Kids [${pageObjNums.map(n => `${n} 0 R`).join(" ")}] /Count ${pageCount} >>\n`);
  endObj();

  const a4W = 595.28;
  const a4H = 841.89;

  for (let i = 0; i < pageCount; i++) {
    const p = jpegPages[i];
    const pageObj = 3 + i * 3;
    const contentObj = 4 + i * 3;
    const imgObj = 5 + i * 3;

    startObj(pageObj);
    pushStr(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${a4W} ${a4H}] /Resources << /XObject << /Im${i} ${imgObj} 0 R >> >> /Contents ${contentObj} 0 R >>\n`);
    endObj();

    const contentStream = `q\n${a4W.toFixed(2)} 0 0 ${a4H.toFixed(2)} 0.00 0.00 cm\n/Im${i} Do\nQ\n`;
    startObj(contentObj);
    pushStr(`<< /Length ${contentStream.length} >>\nstream\n${contentStream}endstream\n`);
    endObj();

    startObj(imgObj);
    pushStr(`<< /Type /XObject /Subtype /Image /Width ${p.width} /Height ${p.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.bytes.length} >>\nstream\n`);
    pushBytes(p.bytes);
    pushStr(`\nendstream\n`);
    endObj();
  }

  const xrefOffset = byteLength;
  const totalObjs = 3 + pageCount * 3;
  pushStr(`xref\n0 ${totalObjs}\n`);
  pushStr(`0000000000 65535 f \n`);
  for (let objNum = 1; objNum < totalObjs; objNum++) {
    const offStr = String(offsets[objNum]).padStart(10, "0");
    pushStr(`${offStr} 00000 n \n`);
  }

  pushStr(`trailer\n<< /Size ${totalObjs} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF`);

  const merged = new Uint8Array(byteLength);
  let cursor = 0;
  for (const c of chunks) {
    merged.set(c, cursor);
    cursor += c.length;
  }
  return merged;
}

function dataUrlToUint8Array(dataUrl) {
  const base64 = dataUrl.split(",")[1];
  const binStr = atob(base64);
  const len = binStr.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++) bytes[i] = binStr.charCodeAt(i);
  return bytes;
}

function triggerBlobDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  a.style.display = "none";
  document.body.appendChild(a);
  a.click();
  setTimeout(() => {
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, 1500);
}

function exportReportAsPDF(mode, btnId, infoBoxId) {
  const btn = btnId ? document.getElementById(btnId) : null;
  const origText = btn ? btn.textContent : "";
  if (btn) {
    btn.textContent = "PDF 문서 생성 중...";
    btn.disabled = true;
  }

  try {
    if (mode === "single" && !LAST_SINGLE_REPORT) runSingleAnalysis(false);
    if (mode === "compat" && !LAST_COMPAT_REPORT) runCompatAnalysis(false);

    const pageCanvases = mode === "single"
      ? renderSingleReportPages(LAST_SINGLE_REPORT)
      : renderCompatReportPages(LAST_COMPAT_REPORT);

    const jpegPages = pageCanvases.map(canvas => ({
      width: canvas.width,
      height: canvas.height,
      bytes: dataUrlToUint8Array(canvas.toDataURL("image/jpeg", 0.92))
    }));

    const pdfBytes = buildMultiPagePdfBinary(jpegPages);
    const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
    const filename = getExportFileName(mode, "pdf");
    triggerBlobDownload(pdfBlob, filename);

    showMsg(infoBoxId, `PDF 저장 완료: '${filename}' (총 ${jpegPages.length}페이지 · 2페이지부터 심층 리포트 시작) 파일이 다운로드되었습니다.`);
  } catch (err) {
    showMsg(infoBoxId, "PDF 생성 중 일시적 오류가 발생했습니다. 상단 '리포트 인쇄' 버튼을 이용해 주세요.");
  } finally {
    if (btn) {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }
}

function exportReportAsPNG(mode, btnId, infoBoxId) {
  const btn = btnId ? document.getElementById(btnId) : null;
  const origText = btn ? btn.textContent : "";
  if (btn) {
    btn.textContent = "PNG 이미지 생성 중...";
    btn.disabled = true;
  }

  try {
    if (mode === "single" && !LAST_SINGLE_REPORT) runSingleAnalysis(false);
    if (mode === "compat" && !LAST_COMPAT_REPORT) runCompatAnalysis(false);

    const pageCanvases = mode === "single"
      ? renderSingleReportPages(LAST_SINGLE_REPORT)
      : renderCompatReportPages(LAST_COMPAT_REPORT);

    const gap = 24;
    const totalW = pageCanvases[0].width;
    const totalH = pageCanvases.reduce((acc, c) => acc + c.height, 0) + gap * (pageCanvases.length - 1);

    const mergedCanvas = document.createElement("canvas");
    mergedCanvas.width = totalW;
    mergedCanvas.height = totalH;
    const mCtx = mergedCanvas.getContext("2d");
    mCtx.fillStyle = "#e2e8f0";
    mCtx.fillRect(0, 0, totalW, totalH);

    let curY = 0;
    pageCanvases.forEach(c => {
      mCtx.drawImage(c, 0, curY);
      curY += c.height + gap;
    });

    const filename = getExportFileName(mode, "png");
    mergedCanvas.toBlob((blob) => {
      if (blob) {
        triggerBlobDownload(blob, filename);
        showMsg(infoBoxId, `PNG 저장 완료: '${filename}' (${pageCanvases.length}페이지 통합 고화질 이미지) 파일이 다운로드되었습니다.`);
      }
      if (btn) {
        btn.textContent = origText;
        btn.disabled = false;
      }
    }, "image/png");
  } catch (err) {
    showMsg(infoBoxId, "PNG 저장 중 일시적 오류가 발생했습니다. 'PDF 파일 다운로드' 버튼을 이용해 주세요.");
    if (btn) {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }
}

function safePrintReport(mode, infoBoxId) {
  showMsg(infoBoxId, "인쇄 대화상자를 호출합니다. 미리보기 환경에서 인쇄창이 열리지 않을 경우 자동으로 PDF 파일 다운로드를 실행합니다.");
  let beforePrintFired = false;
  const onBeforePrint = () => { beforePrintFired = true; };
  window.addEventListener("beforeprint", onBeforePrint, { once: true });

  try {
    window.print();
  } catch (e) {}

  setTimeout(() => {
    window.removeEventListener("beforeprint", onBeforePrint);
    if (!beforePrintFired) {
      exportReportAsPDF(mode, null, infoBoxId);
    }
  }, 600);
}

window.addEventListener("DOMContentLoaded", () => {
  loadCustomDBFromStorage();
  runSingleAnalysis(false);
});
