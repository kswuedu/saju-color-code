    const blendY = colY + 112;
    drawRoundedRect(ctx, MARGIN_X + 24, blendY, CONTENT_W - 48, blendBoxH, 12, "#eff6ff", "#bfdbfe", 1.2);
    drawRoundedRect(ctx, MARGIN_X + 40, blendY + 16, 72, 72, 14, r.blendHex, "#ffffff", 2);
    ctx.font = `700 15px ${FONT_FAMILY}`;
    ctx.fillStyle = "#1d4ed8";
