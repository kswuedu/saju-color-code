          if (parsed.ilganDb[k]) {
            ILGAN_DB[k] = { ...DEFAULT_ILGAN_DB[k], ...parsed.ilganDb[k] };
          }
        });
      }
      persistCustomDBToStorage();
      loadIlganEditorForm();
