// 활성 데이터베이스 (localStorage 불러오기 및 병합)
const STORAGE_KEY_V1 = "saju_color_code_custom_db_v1";
let TEMPERAMENT_COLORS = JSON.parse(JSON.stringify(DEFAULT_TEMPERAMENT_COLORS));
let BALANCE_COLORS = JSON.parse(JSON.stringify(DEFAULT_BALANCE_COLORS));
let ILGAN_DB = JSON.parse(JSON.stringify(DEFAULT_ILGAN_DB));

function loadCustomDBFromStorage() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY_V1);
    if (!raw) return;
    const parsed = JSON.parse(raw);
    if (parsed.temperamentColors) {
      Object.keys(DEFAULT_TEMPERAMENT_COLORS).forEach(k => {
        if (parsed.temperamentColors[k]) {
          TEMPERAMENT_COLORS[k] = { ...DEFAULT_TEMPERAMENT_COLORS[k], ...parsed.temperamentColors[k] };
        }
      });
    }
    if (parsed.balanceColors) {
      Object.keys(DEFAULT_BALANCE_COLORS).forEach(k => {
        if (parsed.balanceColors[k]) {
          BALANCE_COLORS[k] = { ...DEFAULT_BALANCE_COLORS[k], ...parsed.balanceColors[k] };
        }
      });
    }
    if (parsed.ilganDb) {
      Object.keys(DEFAULT_ILGAN_DB).forEach(k => {
        if (parsed.ilganDb[k]) {
          ILGAN_DB[k] = { ...DEFAULT_ILGAN_DB[k], ...parsed.ilganDb[k] };
        }
      });
    }
  } catch (e) {}
}

function persistCustomDBToStorage() {
  try {
    const payload = {
      temperamentColors: TEMPERAMENT_COLORS,
      balanceColors: BALANCE_COLORS,
      ilganDb: ILGAN_DB
    };
    localStorage.setItem(STORAGE_KEY_V1, JSON.stringify(payload));
  } catch (e) {}
}

