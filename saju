      const sy = pm.getY();
      drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, boxH, 16, "#ffffff", "#cbd5e1", 1.8);
      drawRoundedRect(c, MARGIN_X + 22, sy + 20, 20, 20, 10, box.hex, "#94a3b8", 1);
      c.font = `800 21px ${FONT_FAMILY}`;
      c.fillStyle = "#0f172a";
      c.fillText(box.title, MARGIN_X + 52, sy + 37);

      c.font = `500 19px ${FONT_FAMILY}`;
      c.fillStyle = "#334155";
      let ly = sy + 68;
      box.lines.forEach(l => {
        c.fillText(l, MARGIN_X + 24, ly);
        ly += 27;
      });
      pm.addY(boxH + 14);
    });
    pm.addY(6);
  }

  // 4. 사주명식 4기둥 표
  {
    const cardH = 318;
    pm.ensureSpace(cardH + 20);
    const c = pm.getCtx();
    const sy = pm.getY();
    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, cardH, 18, "#ffffff", "#cbd5e1", 2);

    c.font = `800 22px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("사주명식 (四柱命式 · 4개의 기둥)", MARGIN_X + 24, sy + 42);

    const tableX = MARGIN_X + 24;
    const tableY = sy + 60;
    const tableW = CONTENT_W - 48;
    const colW = tableW / 5;
    const rowHeights = [40, 38, 62, 62, 36];
    const headers = ["구분", "시주 (말년)", "일주 (나)", "월주 (청년)", "년주 (초년)"];
    const keys = ["hour", "day", "month", "year"];

    let curY = tableY;
    // 헤더
    drawRoundedRect(c, tableX, curY, tableW, rowHeights[0], 6, "#f1f5f9", "#cbd5e1", 1.2);
    c.font = `700 18px ${FONT_FAMILY}`;
    c.fillStyle = "#475569";
    c.textAlign = "center";
    headers.forEach((h, idx) => {
      c.fillText(h, tableX + colW * idx + colW / 2, curY + 26);
    });
    curY += rowHeights[0];

    const rowLabels = ["천간 십성", "천간 (天干)", "지지 (地支)", "지지 십성", "12운성"];
    for (let rIdx = 0; rIdx < 5; rIdx++) {
      const rh = rowHeights[rIdx];
      c.strokeStyle = "#e2e8f0";
      c.lineWidth = 1.2;
      c.strokeRect(tableX, curY, tableW, rh);

      c.font = `700 18px ${FONT_FAMILY}`;
      c.fillStyle = "#0f172a";
      c.fillText(rowLabels[rIdx], tableX + colW / 2, curY + rh / 2 + 6);

      keys.forEach((k, kIdx) => {
        const cx = tableX + colW * (kIdx + 1) + colW / 2;
        c.strokeRect(tableX + colW * (kIdx + 1), curY, colW, rh);
        const p = r.pillars[k];
        if (!p) {
          c.font = `500 17px ${FONT_FAMILY}`;
          c.fillStyle = "#94a3b8";
          c.fillText("시간 미상", cx, curY + rh / 2 + 6);
          return;
        }
        const gOh = GAN_OHAENG[p.ganIdx];
        const jOh = JI_OHAENG[p.jiIdx];
        if (rIdx === 0) {
          const gSip = k === "day" ? "본원(일간)" : getSipseong(r.dayGanIdx, p.ganIdx);
          c.font = `700 17px ${FONT_FAMILY}`;
          c.fillStyle = "#334155";
          c.fillText(gSip, cx, curY + 25);
        } else if (rIdx === 1) {
          c.font = `800 30px ${FONT_FAMILY}`;
          c.fillStyle = ohColorHex[gOh];
          c.fillText(`${CHEONGAN_HANJA[p.ganIdx]} (${CHEONGAN[p.ganIdx]}·${gOh})`, cx, curY + 41);
        } else if (rIdx === 2) {
          c.font = `800 30px ${FONT_FAMILY}`;
          c.fillStyle = ohColorHex[jOh];
          c.fillText(`${JIJI_HANJA[p.jiIdx]} (${JIJI[p.jiIdx]}·${jOh})`, cx, curY + 41);
        } else if (rIdx === 3) {
          const jSip = getSipseong(r.dayGanIdx, JI_MAIN_GAN[p.jiIdx]);
          c.font = `700 17px ${FONT_FAMILY}`;
          c.fillStyle = "#334155";
          c.fillText(jSip, cx, curY + 24);
        } else if (rIdx === 4) {
          const uns = get12Unseong(r.dayGanIdx, p.jiIdx);
          c.font = `700 17px ${FONT_FAMILY}`;
          c.fillStyle = "#0f172a";
          c.fillText(uns, cx, curY + 24);
        }
      });
      curY += rh;
    }
    c.textAlign = "left";
    pm.addY(cardH + 20);
  }

  // 5. 10년 대운 및 2026·2027 세운 분석 카드
  {
    const ctx = pm.getCtx();
    ctx.font = `500 18px ${FONT_FAMILY}`;
    const s26Lines = [
      ...wrapCanvasLines(ctx, `• 핵심 테마: ${r.s26.theme} (${r.curDaeunStr} 결합)`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 전반적 흐름: ${r.s26.flow}`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 재물·커리어: ${r.s26.action}`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 주의 변수: ${r.s26.caution}`, CONTENT_W - 84)
    ];
    const s27Lines = [
      ...wrapCanvasLines(ctx, `• 핵심 테마: ${r.s27.theme}`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 전반적 흐름: ${r.s27.flow}`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 재물·커리어: ${r.s27.action}`, CONTENT_W - 84),
      ...wrapCanvasLines(ctx, `• 주의 변수: ${r.s27.caution}`, CONTENT_W - 84)
    ];
    const s26H = 56 + s26Lines.length * 26;
    const s27H = 56 + s27Lines.length * 26;
    const totalH = 195 + s26H + s27H + 28;

    pm.ensureSpace(totalH + 20);
    const c = pm.getCtx();
    const sy = pm.getY();
    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, totalH, 18, "#ffffff", "#cbd5e1", 2);

    c.font = `800 22px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("10년 대운(大運) 및 2026 병오년 · 2027 정미년 세운 분석", MARGIN_X + 24, sy + 42);

    c.font = `700 18px ${FONT_FAMILY}`;
    c.fillStyle = "#2563eb";
    c.textAlign = "right";
    c.fillText(r.daeunDirStr, MARGIN_X + CONTENT_W - 24, sy + 42);
    c.textAlign = "left";

    // 대운 8칸
    const cellGap = 8;
    const cellW = (CONTENT_W - 48 - cellGap * 7) / 8;
    const cellY = sy + 60;
    const cellH = 112;
    r.daeunList.forEach((d, idx) => {
      const cx = MARGIN_X + 24 + idx * (cellW + cellGap);
      const nextAge = idx < r.daeunList.length - 1 ? r.daeunList[idx + 1].age : d.age + 10;
      const isCur = r.currentKoreanAge >= d.age && r.currentKoreanAge < nextAge;
      drawRoundedRect(c, cx, cellY, cellW, cellH, 10, isCur ? "#eff6ff" : "#f8fafc", isCur ? "#2563eb" : "#e2e8f0", isCur ? 2 : 1.2);

      c.textAlign = "center";
      c.font = `700 15px ${FONT_FAMILY}`;
      c.fillStyle = isCur ? "#1d4ed8" : "#475569";
      c.fillText(`${d.age}세${isCur ? "(현)" : ""}`, cx + cellW / 2, cellY + 24);

      c.font = `800 22px ${FONT_FAMILY}`;
      c.fillStyle = "#0f172a";
      c.fillText(`${CHEONGAN_HANJA[d.ganIdx]}${JIJI_HANJA[d.jiIdx]}`, cx + cellW / 2, cellY + 54);

      c.font = `600 15px ${FONT_FAMILY}`;
      c.fillStyle = "#334155";
      c.fillText(`${CHEONGAN[d.ganIdx]}${JIJI[d.jiIdx]}`, cx + cellW / 2, cellY + 76);

      const gSip = getSipseong(r.dayGanIdx, d.ganIdx);
      const jSip = getSipseong(r.dayGanIdx, JI_MAIN_GAN[d.jiIdx]);
      c.font = `500 14px ${FONT_FAMILY}`;
      c.fillStyle = "#64748b";
      c.fillText(`${gSip}·${jSip}`, cx + cellW / 2, cellY + 98);
    });
    c.textAlign = "left";

    // 2026 세운 박스
    let boxY = cellY + cellH + 16;
    drawRoundedRect(c, MARGIN_X + 24, boxY, CONTENT_W - 48, s26H, 14, "#fffbeb", "#fde68a", 1.5);
    c.font = `800 20px ${FONT_FAMILY}`;
    c.fillStyle = "#451a03";
    c.fillText(`2026년 병오년 (丙午年 · 붉은 말) — [${r.seun2026GanSip} · ${r.seun2026JiSip}운]`, MARGIN_X + 42, boxY + 34);
    c.font = `500 18px ${FONT_FAMILY}`;
    let ly = boxY + 62;
    s26Lines.forEach(l => { c.fillText(l, MARGIN_X + 42, ly); ly += 26; });

    // 2027 세운 박스
    boxY += s26H + 12;
    drawRoundedRect(c, MARGIN_X + 24, boxY, CONTENT_W - 48, s27H, 14, "#fef2f2", "#fecaca", 1.5);
    c.font = `800 20px ${FONT_FAMILY}`;
    c.fillStyle = "#450a0a";
    c.fillText(`2027년 정미년 (丁未年 · 붉은 양) — [${r.seun2027GanSip} · ${r.seun2027JiSip}운]`, MARGIN_X + 42, boxY + 34);
    c.font = `500 18px ${FONT_FAMILY}`;
    ly = boxY + 62;
    s27Lines.forEach(l => { c.fillText(l, MARGIN_X + 42, ly); ly += 26; });

    pm.addY(totalH + 20);
  }

  // 6. 오행 분포 그래프 카드
  {
    const ctx = pm.getCtx();
    ctx.font = `500 19px ${FONT_FAMILY}`;
    const sumLines = wrapCanvasLines(ctx, r.ohaengSummaryPlain, CONTENT_W - 76);
    const sumBoxH = 26 + sumLines.length * 27;
    const cardH = 255 + sumBoxH;

    pm.ensureSpace(cardH + 20);
    const c = pm.getCtx();
    const sy = pm.getY();
    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, cardH, 18, "#ffffff", "#cbd5e1", 2);

    c.font = `800 22px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("오행(五行) 에너지 분포 및 과다·부족 분석", MARGIN_X + 24, sy + 42);

    let barY = sy + 68;
    r.ohaengMeta.forEach(item => {
      const pct = r.ratios[item.key] || 0;
      c.font = `700 19px ${FONT_FAMILY}`;
      c.fillStyle = item.hex;
      c.fillText(item.label, MARGIN_X + 24, barY + 17);

      const trackX = MARGIN_X + 120;
      const trackW = CONTENT_W - 220;
      drawRoundedRect(c, trackX, barY + 2, trackW, 18, 9, "#f1f5f9", null);
      const fillW = Math.max(8, Math.round((pct / 100) * trackW));
      if (pct > 0) {
        drawRoundedRect(c, trackX, barY + 2, fillW, 18, 9, item.hex, null);
      }

      c.font = `700 19px ${FONT_FAMILY}`;
      c.fillStyle = "#0f172a";
      c.textAlign = "right";
      c.fillText(`${pct}%`, MARGIN_X + CONTENT_W - 24, barY + 17);
      c.textAlign = "left";
      barY += 34;
    });

    drawRoundedRect(c, MARGIN_X + 24, barY + 6, CONTENT_W - 48, sumBoxH, 12, "#f8fafc", "#cbd5e1", 1.2);
    c.fillStyle = "#0f172a";
    c.fillRect(MARGIN_X + 24, barY + 6, 6, sumBoxH);

    c.font = `500 19px ${FONT_FAMILY}`;
    c.fillStyle = "#334155";
    let ty = barY + 32;
    sumLines.forEach(l => { c.fillText(l, MARGIN_X + 44, ty); ty += 27; });

    pm.addY(cardH + 20);
  }

  // ==========================================================================
  // [필수 요구사항] '심층 기질 및 운세 종합 리포트 (10대 핵심 영역)'부터 무조건 새 페이지 시작
  // ==========================================================================
  pm.forcePageBreak();

  {
    const c = pm.getCtx();
    c.font = `800 26px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("심층 기질 및 운세 종합 리포트 (10대 핵심 영역)", MARGIN_X, pm.getY() + 24);
    pm.addY(44);
  }

  // 10대 상세 분석 카드 각각 사전 높이 측정 후 블록 단위 배치 (절대 중간 절단 없음)
  r.details.forEach(d => {
    const tmpCtx = pm.getCtx();
    tmpCtx.font = `500 20px ${FONT_FAMILY}`;
    const bodyLines = wrapCanvasLines(tmpCtx, d.content, CONTENT_W - 48);
    const itemH = 68 + bodyLines.length * 30;

    pm.ensureSpace(itemH + 14);
    const c = pm.getCtx();
    const sy = pm.getY();

    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, itemH, 16, "#ffffff", "#cbd5e1", 1.8);
    c.font = `800 21px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText(d.title, MARGIN_X + 24, sy + 36);

    c.font = `500 20px ${FONT_FAMILY}`;
    c.fillStyle = "#334155";
    let ty = sy + 68;
    bodyLines.forEach(line => {
      c.fillText(line, MARGIN_X + 24, ty);
      ty += 30;
    });

    pm.addY(itemH + 14);
  });

  // 8. 최종 종합 정리 (One-Page Summary) 표 — 각 행(Row) 단위 사전 높이 측정 및 페이지 넘김 보호
  {
    const tmpCtx = pm.getCtx();
    tmpCtx.font = `500 20px ${FONT_FAMILY}`;
    const leadLines = wrapCanvasLines(tmpCtx, r.finalSummaryLeadStr, CONTENT_W - 48);
    const headerBlockH = 74 + leadLines.length * 29;

    pm.ensureSpace(headerBlockH + 90);
    const c = pm.getCtx();
    const sy = pm.getY();
    c.font = `800 24px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText(`최종 종합 정리 (One-Page Summary · ${r.name}님 마스터 시트)`, MARGIN_X, sy + 28);

    c.font = `500 20px ${FONT_FAMILY}`;
    c.fillStyle = "#1e293b";
    let ly = sy + 64;
    leadLines.forEach(l => { c.fillText(l, MARGIN_X, ly); ly += 29; });
    pm.setY(ly + 10);

    const keyColW = 240;
    const valColW = CONTENT_W - keyColW;

    r.summaryRows.forEach(row => {
      const mCtx = pm.getCtx();
      mCtx.font = `500 19px ${FONT_FAMILY}`;
      const valLines = wrapCanvasLines(mCtx, row.val, valColW - 32);
      const rowH = Math.max(52, 26 + valLines.length * 27);

      pm.ensureSpace(rowH);
      const rc = pm.getCtx();
      const ry = pm.getY();

      rc.fillStyle = "#f1f5f9";
      rc.fillRect(MARGIN_X, ry, keyColW, rowH);
      rc.fillStyle = "#ffffff";
      rc.fillRect(MARGIN_X + keyColW, ry, valColW, rowH);

      rc.strokeStyle = "#cbd5e1";
      rc.lineWidth = 1.5;
      rc.strokeRect(MARGIN_X, ry, keyColW, rowH);
      rc.strokeRect(MARGIN_X + keyColW, ry, valColW, rowH);

      rc.font = `700 19px ${FONT_FAMILY}`;
      rc.fillStyle = "#0f172a";
      rc.fillText(row.key, MARGIN_X + 16, ry + 33);

      rc.font = `500 19px ${FONT_FAMILY}`;
      rc.fillStyle = "#334155";
      let vy = ry + 32;
      valLines.forEach(vl => {
        rc.fillText(vl, MARGIN_X + keyColW + 16, vy);
        vy += 27;
      });

      pm.addY(rowH);
    });
  }

  pm.finalizeFooters();
  return pm.getPages();
}

// 두 사람 궁합 리포트 A4 다중 페이지 캔버스 렌더링
function renderCompatReportPages(r) {
  const pm = createPaginatedCanvasManager();
  const { MARGIN_X, CONTENT_W, FONT_FAMILY } = pm;

  // 1. 헤더
  {
    const ctx = pm.getCtx();
    ctx.font = `800 36px ${FONT_FAMILY}`;
    ctx.fillStyle = "#0f172a";
    ctx.fillText("사주&컬러코드 두 사람 궁합 & 시너지 리포트", MARGIN_X, pm.getY() + 28);
    pm.addY(56);
  }

  // 2. 종합 점수 및 3대 지표 & 컬러 카드
  {
    const ctx = pm.getCtx();
    ctx.font = `500 20px ${FONT_FAMILY}`;
    const subLines = wrapCanvasLines(ctx, r.compatSubSummaryStr, CONTENT_W - 180);
    const cardH = 340 + subLines.length * 29;
    pm.ensureSpace(cardH);

    const sy = pm.getY();
    drawRoundedRect(ctx, MARGIN_X, sy, CONTENT_W, cardH, 18, "#ffffff", "#cbd5e1", 2);

    // 히어로 박스
    const heroH = 120 + subLines.length * 29;
    drawRoundedRect(ctx, MARGIN_X + 24, sy + 22, CONTENT_W - 48, heroH, 14, "#eff6ff", "#bfdbfe", 1.5);
    ctx.font = `700 18px ${FONT_FAMILY}`;
    ctx.fillStyle = "#1d4ed8";
    ctx.fillText(`${r.p1.name}(${r.p1Ilju}) × ${r.p2.name}(${r.p2Ilju})`, MARGIN_X + 42, sy + 52);

    ctx.font = `800 26px ${FONT_FAMILY}`;
    ctx.fillStyle = "#0f172a";
    ctx.fillText(r.compatHeadlineStr, MARGIN_X + 42, sy + 88);

    ctx.font = `500 20px ${FONT_FAMILY}`;
    ctx.fillStyle = "#334155";
    let ty = sy + 122;
    subLines.forEach(l => { ctx.fillText(l, MARGIN_X + 42, ty); ty += 29; });

    // 점수 원
    const circleX = MARGIN_X + CONTENT_W - 96;
    const circleY = sy + 22 + heroH / 2;
    ctx.beginPath();
    ctx.arc(circleX, circleY, 52, 0, Math.PI * 2);
    ctx.fillStyle = "#0f172a";
    ctx.fill();
    ctx.textAlign = "center";
    ctx.font = `800 28px ${FONT_FAMILY}`;
    ctx.fillStyle = "#ffffff";
    ctx.fillText(`${r.totalCompatScore || r.totalScore}점`, circleX, circleY + 6);
    ctx.font = `600 14px ${FONT_FAMILY}`;
    ctx.fillText("종합 시너지", circleX, circleY + 28);
    ctx.textAlign = "left";

    // 3대 서브 점수
    const subY = sy + 22 + heroH + 16;
    const subW = (CONTENT_W - 48 - 24) / 3;
    const subItems = [
      { title: "1. 일간 천간합 (가치관)", val: `${r.ganRes.score}점`, lbl: r.ganRes.label },
      { title: "2. 일지 지지합 (현실호흡)", val: `${r.jiRes.score}점`, lbl: r.jiRes.label },
      { title: "3. 오행 상호 보완", val: `${r.ohRes.score}점`, lbl: r.ohRes.label }
    ];
    subItems.forEach((it, i) => {
      const sx = MARGIN_X + 24 + i * (subW + 12);
      drawRoundedRect(ctx, sx, subY, subW, 96, 12, "#f8fafc", "#e2e8f0", 1.2);
      ctx.textAlign = "center";
      ctx.font = `600 16px ${FONT_FAMILY}`;
      ctx.fillStyle = "#64748b";
      ctx.fillText(it.title, sx + subW / 2, subY + 28);
      ctx.font = `800 24px ${FONT_FAMILY}`;
      ctx.fillStyle = "#0f172a";
      ctx.fillText(it.val, sx + subW / 2, subY + 58);
      ctx.font = `600 15px ${FONT_FAMILY}`;
      ctx.fillStyle = "#2563eb";
      ctx.fillText(it.lbl, sx + subW / 2, subY + 82);
    });
    ctx.textAlign = "left";

    // 두 사람 컬러 비교
    const colY = subY + 112;
    const colW = (CONTENT_W - 64) / 2;
    [
      { x: MARGIN_X + 24, name: r.p1.name, c: r.c1, weak: r.p1.weakestOhaeng },
      { x: MARGIN_X + 24 + colW + 16, name: r.p2.name, c: r.c2, weak: r.p2.weakestOhaeng }
    ].forEach(p => {
      drawRoundedRect(ctx, p.x, colY, colW, 96, 12, "#f8fafc", "#e2e8f0", 1.2);
      drawRoundedRect(ctx, p.x + 14, colY + 14, 68, 68, 12, p.c.hex, "#cbd5e1", 1.2);
      ctx.font = `600 16px ${FONT_FAMILY}`;
      ctx.fillStyle = "#64748b";
      ctx.fillText(`${p.name}님의 본질 컬러`, p.x + 96, colY + 32);
      ctx.font = `800 21px ${FONT_FAMILY}`;
      ctx.fillStyle = "#0f172a";
      ctx.fillText(p.c.name, p.x + 96, colY + 60);
      ctx.font = `500 16px ${FONT_FAMILY}`;
      ctx.fillStyle = "#475569";
      ctx.fillText(`${p.c.keyword} (부족: ${p.weak})`, p.x + 96, colY + 84);
    });

    pm.addY(cardH + 20);
  }

  // 3. 사주명식 핵심 대조표
  {
    const cardH = 330;
    pm.ensureSpace(cardH + 20);
    const c = pm.getCtx();
    const sy = pm.getY();
    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, cardH, 18, "#ffffff", "#cbd5e1", 2);
    c.font = `800 22px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("두 사람 사주명식 핵심 대조", MARGIN_X + 24, sy + 42);

    const tx = MARGIN_X + 24;
    let ty = sy + 60;
    const tw = CONTENT_W - 48;
    const cw = tw / 3;

    drawRoundedRect(c, tx, ty, tw, 40, 6, "#f1f5f9", "#cbd5e1", 1.2);
    c.textAlign = "center";
    c.font = `700 18px ${FONT_FAMILY}`;
    c.fillStyle = "#475569";
    c.fillText("구분", tx + cw * 0.5, ty + 26);
    c.fillText(`${r.p1.name} (${r.p1.gender})`, tx + cw * 1.5, ty + 26);
    c.fillText(`${r.p2.name} (${r.p2.gender})`, tx + cw * 2.5, ty + 26);
    ty += 40;

    r.compareRows.forEach(row => {
      c.strokeStyle = "#e2e8f0";
      c.strokeRect(tx, ty, cw, 36);
      c.strokeRect(tx + cw, ty, cw, 36);
      c.strokeRect(tx + cw * 2, ty, cw, 36);
      c.font = `700 17px ${FONT_FAMILY}`;
      c.fillStyle = "#0f172a";
      c.fillText(row.label, tx + cw * 0.5, ty + 24);
      c.font = `600 17px ${FONT_FAMILY}`;
      c.fillStyle = "#334155";
      c.fillText(row.v1, tx + cw * 1.5, ty + 24);
      c.fillText(row.v2, tx + cw * 2.5, ty + 24);
      ty += 36;
    });
    c.textAlign = "left";
    pm.addY(cardH + 20);
  }

  // 4. 심층 관계 및 시너지 코칭 리포트 (새 페이지 시작)
  pm.forcePageBreak();
  {
    const c = pm.getCtx();
    c.font = `800 26px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText("심층 관계 및 시너지 코칭 리포트", MARGIN_X, pm.getY() + 24);
    pm.addY(44);
  }

  r.compatDetails.forEach(d => {
    const tmpCtx = pm.getCtx();
    tmpCtx.font = `500 20px ${FONT_FAMILY}`;
    const bodyLines = wrapCanvasLines(tmpCtx, d.content, CONTENT_W - 48);
    const itemH = 68 + bodyLines.length * 30;

    pm.ensureSpace(itemH + 14);
    const c = pm.getCtx();
    const sy = pm.getY();
    drawRoundedRect(c, MARGIN_X, sy, CONTENT_W, itemH, 16, "#ffffff", "#cbd5e1", 1.8);
    c.font = `800 21px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText(d.title, MARGIN_X + 24, sy + 36);

    c.font = `500 20px ${FONT_FAMILY}`;
    c.fillStyle = "#334155";
    let ty = sy + 68;
    bodyLines.forEach(l => { c.fillText(l, MARGIN_X + 24, ty); ty += 30; });
    pm.addY(itemH + 14);
  });

  // 5. 궁합 최종 종합 정리표
  {
    pm.ensureSpace(120);
    const c = pm.getCtx();
    c.font = `800 24px ${FONT_FAMILY}`;
    c.fillStyle = "#0f172a";
    c.fillText(`두 사람 궁합 & 시너지 최종 종합 정리 (${r.p1.name} × ${r.p2.name})`, MARGIN_X, pm.getY() + 28);
    pm.addY(46);

    const keyColW = 240;
    const valColW = CONTENT_W - keyColW;
    r.compatSummaryRows.forEach(row => {
      const mCtx = pm.getCtx();
      mCtx.font = `500 19px ${FONT_FAMILY}`;
      const valLines = wrapCanvasLines(mCtx, row.val, valColW - 32);
      const rowH = Math.max(52, 26 + valLines.length * 27);

      pm.ensureSpace(rowH);
      const rc = pm.getCtx();
      const ry = pm.getY();
      rc.fillStyle = "#f1f5f9";
      rc.fillRect(MARGIN_X, ry, keyColW, rowH);
      rc.fillStyle = "#ffffff";
      rc.fillRect(MARGIN_X + keyColW, ry, valColW, rowH);
      rc.strokeStyle = "#cbd5e1";
      rc.lineWidth = 1.5;
      rc.strokeRect(MARGIN_X, ry, keyColW, rowH);
      rc.strokeRect(MARGIN_X + keyColW, ry, valColW, rowH);

      rc.font = `700 19px ${FONT_FAMILY}`;
      rc.fillStyle = "#0f172a";
      rc.fillText(row.key, MARGIN_X + 16, ry + 33);

      rc.font = `500 19px ${FONT_FAMILY}`;
      rc.fillStyle = "#334155";
      let vy = ry + 32;
      valLines.forEach(vl => { rc.fillText(vl, MARGIN_X + keyColW + 16, vy); vy += 27; });
      pm.addY(rowH);
    });
  }

  pm.finalizeFooters();
  return pm.getPages();
}

// 다중 페이지 JPEG 배열 → 표준 PDF 1.4 바이너리 조립
function buildMultiPagePdfBinary(jpegPages) {
  const encoder = new TextEncoder();
  const chunks = [];
  let byteLength = 0;

  function pushStr(str) {
    const bytes = encoder.encode(str);
    chunks.push(bytes);
    byteLength += bytes.length;
  }
  function pushBytes(uint8) {
    chunks.push(uint8);
    byteLength += uint8.length;
  }

  const offsets = [0];
  function startObj(objNum) {
    offsets[objNum] = byteLength;
    pushStr(`${objNum} 0 obj\n`);
  }
  function endObj() {
    pushStr(`endobj\n`);
  }

  pushStr("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n");

  const pageCount = jpegPages.length;
  const pageObjNums = [];
  for (let i = 0; i < pageCount; i++) pageObjNums.push(3 + i * 3);

  startObj(1);
  pushStr(`<< /Type /Catalog /Pages 2 0 R >>\n`);
  endObj();

  startObj(2);
  pushStr(`<< /Type /Pages /Kids [${pageObjNums.map(n => `${n} 0 R`).join(" ")}] /Count ${pageCount} >>\n`);
  endObj();

  const a4W = 595.28;
  const a4H = 841.89;

  for (let i = 0; i < pageCount; i++) {
    const p = jpegPages[i];
    const pageObj = 3 + i * 3;
    const contentObj = 4 + i * 3;
    const imgObj = 5 + i * 3;

    startObj(pageObj);
    pushStr(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${a4W} ${a4H}] /Resources << /XObject << /Im${i} ${imgObj} 0 R >> >> /Contents ${contentObj} 0 R >>\n`);
    endObj();

    const contentStream = `q\n${a4W.toFixed(2)} 0 0 ${a4H.toFixed(2)} 0.00 0.00 cm\n/Im${i} Do\nQ\n`;
    startObj(contentObj);
    pushStr(`<< /Length ${contentStream.length} >>\nstream\n${contentStream}endstream\n`);
    endObj();

    startObj(imgObj);
    pushStr(`<< /Type /XObject /Subtype /Image /Width ${p.width} /Height ${p.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.bytes.length} >>\nstream\n`);
    pushBytes(p.bytes);
    pushStr(`\nendstream\n`);
    endObj();
  }

  const xrefOffset = byteLength;
  const totalObjs = 3 + pageCount * 3;
  pushStr(`xref\n0 ${totalObjs}\n`);
  pushStr(`0000000000 65535 f \n`);
  for (let objNum = 1; objNum < totalObjs; objNum++) {
    const offStr = String(offsets[objNum]).padStart(10, "0");
    pushStr(`${offStr} 00000 n \n`);
  }

  pushStr(`trailer\n<< /Size ${totalObjs} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF`);

  const merged = new Uint8Array(byteLength);
  let cursor = 0;
  for (const c of chunks) {
    merged.set(c, cursor);
    cursor += c.length;
  }
  return merged;
}

function dataUrlToUint8Array(dataUrl) {
  const base64 = dataUrl.split(",")[1];
  const binStr = atob(base64);
  const len = binStr.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++) bytes[i] = binStr.charCodeAt(i);
  return bytes;
}

function triggerBlobDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  a.style.display = "none";
  document.body.appendChild(a);
  a.click();
  setTimeout(() => {
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, 1500);
}

function exportReportAsPDF(mode, btnId, infoBoxId) {
  const btn = btnId ? document.getElementById(btnId) : null;
  const origText = btn ? btn.textContent : "";
  if (btn) {
    btn.textContent = "PDF 문서 생성 중...";
    btn.disabled = true;
  }

  try {
    if (mode === "single" && !LAST_SINGLE_REPORT) runSingleAnalysis(false);
    if (mode === "compat" && !LAST_COMPAT_REPORT) runCompatAnalysis(false);

    const pageCanvases = mode === "single"
      ? renderSingleReportPages(LAST_SINGLE_REPORT)
      : renderCompatReportPages(LAST_COMPAT_REPORT);

    const jpegPages = pageCanvases.map(canvas => ({
      width: canvas.width,
      height: canvas.height,
      bytes: dataUrlToUint8Array(canvas.toDataURL("image/jpeg", 0.92))
    }));

    const pdfBytes = buildMultiPagePdfBinary(jpegPages);
    const pdfBlob = new Blob([pdfBytes], { type: "application/pdf" });
    const filename = getExportFileName(mode, "pdf");
    triggerBlobDownload(pdfBlob, filename);

    showMsg(infoBoxId, `PDF 저장 완료: '${filename}' (총 ${jpegPages.length}페이지 · 2페이지부터 심층 리포트 시작) 파일이 다운로드되었습니다.`);
  } catch (err) {
    showMsg(infoBoxId, "PDF 생성 중 일시적 오류가 발생했습니다. 상단 '리포트 인쇄' 버튼을 이용해 주세요.");
  } finally {
    if (btn) {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }
}

function exportReportAsPNG(mode, btnId, infoBoxId) {
  const btn = btnId ? document.getElementById(btnId) : null;
  const origText = btn ? btn.textContent : "";
  if (btn) {
    btn.textContent = "PNG 이미지 생성 중...";
    btn.disabled = true;
  }

  try {
    if (mode === "single" && !LAST_SINGLE_REPORT) runSingleAnalysis(false);
    if (mode === "compat" && !LAST_COMPAT_REPORT) runCompatAnalysis(false);

    const pageCanvases = mode === "single"
      ? renderSingleReportPages(LAST_SINGLE_REPORT)
      : renderCompatReportPages(LAST_COMPAT_REPORT);

    const gap = 24;
    const totalW = pageCanvases[0].width;
    const totalH = pageCanvases.reduce((acc, c) => acc + c.height, 0) + gap * (pageCanvases.length - 1);

    const mergedCanvas = document.createElement("canvas");
    mergedCanvas.width = totalW;
    mergedCanvas.height = totalH;
    const mCtx = mergedCanvas.getContext("2d");
    mCtx.fillStyle = "#e2e8f0";
    mCtx.fillRect(0, 0, totalW, totalH);

    let curY = 0;
    pageCanvases.forEach(c => {
      mCtx.drawImage(c, 0, curY);
      curY += c.height + gap;
    });

    const filename = getExportFileName(mode, "png");
    mergedCanvas.toBlob((blob) => {
      if (blob) {
        triggerBlobDownload(blob, filename);
        showMsg(infoBoxId, `PNG 저장 완료: '${filename}' (${pageCanvases.length}페이지 통합 고화질 이미지) 파일이 다운로드되었습니다.`);
      }
      if (btn) {
        btn.textContent = origText;
        btn.disabled = false;
      }
    }, "image/png");
  } catch (err) {
    showMsg(infoBoxId, "PNG 저장 중 일시적 오류가 발생했습니다. 'PDF 파일 다운로드' 버튼을 이용해 주세요.");
    if (btn) {
      btn.textContent = origText;
      btn.disabled = false;
    }
  }
}

function safePrintReport(mode, infoBoxId) {
  showMsg(infoBoxId, "인쇄 대화상자를 호출합니다. 미리보기 환경에서 인쇄창이 열리지 않을 경우 자동으로 PDF 파일 다운로드를 실행합니다.");
  let beforePrintFired = false;
  const onBeforePrint = () => { beforePrintFired = true; };
  window.addEventListener("beforeprint", onBeforePrint, { once: true });

  try {
    window.print();
  } catch (e) {}

  setTimeout(() => {
    window.removeEventListener("beforeprint", onBeforePrint);
    if (!beforePrintFired) {
      exportReportAsPDF(mode, null, infoBoxId);
    }
  }, 600);
}

window.addEventListener("DOMContentLoaded", () => {
  loadCustomDBFromStorage();
  runSingleAnalysis(false);
});
