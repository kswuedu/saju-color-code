      rc.strokeStyle = "#cbd5e1";
      rc.lineWidth = 1.5;
      rc.strokeRect(MARGIN_X, ry, keyColW, rowH);
      rc.strokeRect(MARGIN_X + keyColW, ry, valColW, rowH);

